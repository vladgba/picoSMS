<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/IconBtn"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/text2"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCall"
            style="@style/IconBtn"
            android:contentDescription="@string/call"
            android:src="@drawable/ic_call" />

        <ImageButton
            android:id="@+id/btnMore"
            style="@style/IconBtn"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/toRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/input_bg"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/to"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/to_hint"
            android:imeOptions="actionNext"
            android:inputType="phone"
            android:textColor="@color/text"
            android:textColorHint="@color/text2" />

        <ImageButton
            android:id="@+id/btnPick"
            style="@style/IconBtn"
            android:contentDescription="@string/pick_contact"
            android:src="@drawable/ic_person" />
    </LinearLayout>

    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:stackFromBottom="true"
        android:transcriptMode="normal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/input_bg"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:paddingStart="18dp"
            android:paddingEnd="14dp">

            <EditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/msg_hint"
                android:inputType="textCapSentences|textMultiLine|textShortMessage|textAutoCorrect"
                android:maxLines="6"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text2"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/text2"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/send_bg"
            android:contentDescription="@string/send"
            android:src="@drawable/ic_send"
            android:tint="@color/on_accent" />
    </LinearLayout>
</LinearLayout>
