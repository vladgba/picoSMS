<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/no_messages"
        android:textColor="@color/text2"
        android:visibility="gone" />

    <LinearLayout android:id="@+id/r0" style="@style/WRow">
        <LinearLayout style="@style/WCol">
            <LinearLayout style="@style/WTop">
                <TextView android:id="@+id/n0" style="@style/WName" android:text="@string/sample_name1" />
                <TextView android:id="@+id/t0" style="@style/WTime" android:text="@string/sample_time1" />
            </LinearLayout>
            <TextView android:id="@+id/s0" style="@style/WText" android:text="@string/sample_text1" />
        </LinearLayout>
        <TextView android:id="@+id/o0" style="@style/WOtp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/r1" style="@style/WRow">
        <LinearLayout style="@style/WCol">
            <LinearLayout style="@style/WTop">
                <TextView android:id="@+id/n1" style="@style/WName" android:text="@string/sample_name2" />
                <TextView android:id="@+id/t1" style="@style/WTime" android:text="@string/sample_time2" />
            </LinearLayout>
            <TextView android:id="@+id/s1" style="@style/WText" android:text="@string/sample_text2" />
        </LinearLayout>
        <TextView android:id="@+id/o1" style="@style/WOtp" android:text="@string/sample_code" android:visibility="visible" />
    </LinearLayout>

    <LinearLayout android:id="@+id/r2" style="@style/WRow">
        <LinearLayout style="@style/WCol">
            <LinearLayout style="@style/WTop">
                <TextView android:id="@+id/n2" style="@style/WName" />
                <TextView android:id="@+id/t2" style="@style/WTime" />
            </LinearLayout>
            <TextView android:id="@+id/s2" style="@style/WText" />
        </LinearLayout>
        <TextView android:id="@+id/o2" style="@style/WOtp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/r3" style="@style/WRow">
        <LinearLayout style="@style/WCol">
            <LinearLayout style="@style/WTop">
                <TextView android:id="@+id/n3" style="@style/WName" />
                <TextView android:id="@+id/t3" style="@style/WTime" />
            </LinearLayout>
            <TextView android:id="@+id/s3" style="@style/WText" />
        </LinearLayout>
        <TextView android:id="@+id/o3" style="@style/WOtp" />
    </LinearLayout>
</LinearLayout>
