<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <Switch
            android:id="@+id/swWhitelist"
            style="@style/SwitchRow"
            android:text="@string/wl_mode" />

        <TextView
            style="@style/RowDesc"
            android:text="@string/wl_mode_desc" />

        <Switch
            android:id="@+id/swContacts"
            style="@style/SwitchRow"
            android:text="@string/allow_contacts" />

        <TextView
            style="@style/RowDesc"
            android:text="@string/allow_contacts_desc" />
    </LinearLayout>

    <TextView
        android:id="@+id/blockedRow"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/card_bg"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/text"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingTop="14dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp"
        android:text="@string/rules_help"
        android:textColor="@color/text2"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/noRules"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/no_rules"
        android:textColor="@color/text2" />
</LinearLayout>
